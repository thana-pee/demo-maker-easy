# ============================================================
# Demo Maker Easy — Environment Variables Template
# ============================================================
# วิธีใช้งานบนเครื่อง (Local Development):
#   1. คัดลอกไฟล์นี้เป็น .env.local (ระบบ .gitignore จะไม่ push ไฟล์ .env.local ขึ้น GitHub)
#   2. นำ API Key จาก Google AI Studio (https://aistudio.google.com/apikey) มาใส่หลัง GEMINI_API_KEY=
#   3. รีสตาร์ท dev server (npm run dev)
#
# วิธีใช้งานบน Vercel (Production):
#   ไปที่ Vercel Project -> Settings -> Environment Variables
#   แล้วเพิ่ม GEMINI_API_KEY (และ GEMINI_MODEL ถ้าต้องการเปลี่ยนรุ่น)
# ============================================================

# Google Gemini API Key (ใช้ฝั่ง Server เท่านั้น สำหรับ AI Lyric Co-Pilot และ AI Studio Director)
GEMINI_API_KEY=

# รุ่นโมเดล Gemini ที่ต้องการใช้ (ค่าเริ่มต้นในโค้ดคือ gemini-4-hydrogen)
# ตัวเลือกอื่นในตระกูล Gemini 4: gemini-4-hydrogen | gemini-4-argon | gemini-4-carbon
GEMINI_MODEL=gemini-4-hydrogen

# (ไม่บังคับ) Supabase สำหรับ Cloud Sync & Login (Phase 4D)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
