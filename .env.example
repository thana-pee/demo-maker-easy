# ============================================================
# Demo Maker Easy — Environment Variables Template
# ============================================================
# วิธีใช้งานบนเครื่อง (Local Development):
#   1. คัดลอกไฟล์นี้เป็น .env.local (ระบบ .gitignore จะไม่ push ไฟล์ .env.local ขึ้น GitHub)
#   2. นำ API Key จาก Google AI Studio (https://aistudio.google.com/apikey) มาใส่หลัง GEMINI_API_KEY=
#   3. รีสตาร์ท dev server (npm run dev)
#
# วิธีใช้งานบน Vercel (Production):
#   ไปที่ Vercel Project -> Settings -> Environment Variables
#   แล้วเพิ่ม GEMINI_API_KEY (และ GEMINI_MODEL ถ้าต้องการเปลี่ยนรุ่น)
# ============================================================

# Google Gemini API Key (ใช้ฝั่ง Server เท่านั้น สำหรับ AI Studio Director, Lyric Co-Pilot และ Audio/TTS)
GEMINI_API_KEY=

# รุ่นโมเดล Gemini Public SDK สำหรับงานวิเคราะห์/แต่งเพลง (@google/genai)
# ค่าเริ่มต้นฝั่งระบบจะเลือกตามความเหมาะสมของงาน (Lite: gemini-3.5-flash-lite | Main: gemini-4-hydrogen | Pro: gemini-4-argon)
GEMINI_MODEL=gemini-4-hydrogen

# (ไม่บังคับ) Supabase สำหรับ Cloud Sync & Google Login (Phase 4D + Phase 5F)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Phase 5F: Commercial Server Wallet & PromptPay Auto-Slip Billing ───
# ตั้งค่าเป็น production เมื่อต้องการบังคับ Server Wallet & Slip Verification จริง (ปิด Mock Top-Up)
NEXT_PUBLIC_BILLING_MODE=standalone

# (Server-Only SECRET! ห้ามใช้ prefix NEXT_PUBLIC_ เด็ดขาด)
# Service Role Key จาก Supabase Dashboard -> Settings -> API สำหรับหัก/เติมเครดิตฝั่ง Server
SUPABASE_SERVICE_ROLE_KEY=

# ข้อมูลบัญชีรับเงิน PromptPay ของร้าน/ระบบ (เบอร์มือถือ 10 หลัก, เลขประจำตัว 13 หลัก หรือ e-Wallet 15 หลัก)
PROMPTPAY_RECEIVER_ID=
PROMPTPAY_RECEIVER_NAME=

# ผู้ให้บริการตรวจสลิปธนาคารไทยอัตโนมัติ (เช่น SlipOK / EasySlip)
SLIP_VERIFY_API_URL=
SLIP_VERIFY_API_KEY=

# (ไม่บังคับ) รหัสลับฝั่ง Server สำหรับเรียกดูสรุป Analytics ผ่าน GET /api/analytics/summary (Header: x-analytics-key)
ANALYTICS_ADMIN_KEY=
